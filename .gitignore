# LucidPast .gitignore
# Excludes large binary files, virtual environments, and generated outputs.

# === INPUT & OUTPUT (ACTIVE PIPELINE) ========================
# Source archival photographs (TIFF files: 50-200 MB each)
input/
!input/.gitkeep

# Generated Gaussian Splats (PLY files: 50-150 MB each)
output/
!output/.gitkeep

# === LEGACY OUTPUT DIRECTORIES ================================
# These may still exist from earlier pipeline iterations.
# Safe to delete — see _archive/README.md for context.

# Depth Anything V2 depth maps
Depth-Maps/

# Depth Pro depth maps
Depth-Maps-Pro/

# PNG textures (for mesh pipeline)
Textures/

# Depth Anything V2 meshes (OBJ/PLY: 100-500 MB each)
Meshes/

# Depth Pro meshes (OBJ/PLY: 100-500 MB each)
Meshes-DepthPro/

# Legacy Gaussians-SHARP location (moved to output/gaussians/)
Gaussians-SHARP/

# === PYTHON ENVIRONMENTS =====================================
env/
venv/
ENV/
.venv/
env_depthpro/
env_sharp/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter
.ipynb_checkpoints

# === EXTERNAL MODEL REPOS ====================================
# Active
ml-sharp/

# Legacy (may still exist on disk)
ml-depth-pro/
Depth-Anything-V2/

# === IDE & EDITOR =============================================
.idea/
.vscode/
.agents/

# === BLENDER ==================================================
*.blend1
*.blend2
*.blend@
*.blend.autosave

# === UNITY (future integration) ===============================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
Assets/AssetStoreTools*
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb

# === ANDROID (AR viewer — exploration/ar-android) ============
AR/preprocessing/output/
AR/papers/
.gradle/
local.properties
*.apk
*.aab
*.keystore

# === SYSTEM FILES =============================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# === MISCELLANEOUS ============================================
*.tmp
*.log
logs/
*.zip
*.tar.gz
*.rar

# === KEEP FOLDER STRUCTURE ====================================
!.gitkeep
